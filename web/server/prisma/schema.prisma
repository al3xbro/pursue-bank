// Prisma schema file for User and Admin databases

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @unique @default(autoincrement())
  email      String     @unique
  password   String
  first_name String
  last_name  String
  address    String
  phone      String
  dob        String
  status     UserStatus @default(ACTIVE)

  // Relations to User Database
  transactions Transaction[]
}

model Transaction {
  id               Int             @id @unique @default(autoincrement())
  created_at       DateTime        @default(now())
  transaction_type TransactionType
  amount           Decimal
  description      String?

  account_id  Int
  transfer_id Int?

  origin      String?
  destination String?

  user User @relation(fields: [account_id], references: [id])

  recurring_transaction Recurring_Transaction? @relation(fields: [recurring_id], references: [id])
  recurring_id          Int?
}

model Recurring_Transaction {
  id               Int              @id @unique @default(autoincrement())
  transaction_type TransactionType?
  transaction_list Transaction[]
  day_of_month     Int?
  amount           Decimal?

  account_id  Int?
  transfer_id Int?

  origin      String?
  destination String?
  description String?
  status      RecurringTransactionStatus @default(ACTIVE)
  created_at  DateTime?                  @default(now())
}

enum UserStatus {
  ACTIVE
  DELETED
}

enum RecurringTransactionStatus {
  ACTIVE
  DISABLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  TRANSFER_INTERNAL
  TRANSFER_EXTERNAL
  INTEREST
}
